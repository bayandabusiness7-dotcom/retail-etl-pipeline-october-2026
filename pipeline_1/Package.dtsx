        <SQLTask:SqlTaskData
          SQLTask:Connection="{85B279D9-F0EA-46E2-8949-7BD08BCC5C0F}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'bronze')&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;GO&#xA;&#xA;IF OBJECT_ID(N'bronze.retail_sales_raw', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.retail_sales_raw&#xA;    (&#xA;        [Transaction ID]    VARCHAR(50),&#xA;        [Date]              VARCHAR(50),&#xA;        [Customer ID]       VARCHAR(50),&#xA;        [Gender]            VARCHAR(50),&#xA;        [Age]               VARCHAR(50),&#xA;        [Product Category]  VARCHAR(50),&#xA;        [Quantity]          VARCHAR(50),&#xA;        [Price per Unit]    VARCHAR(50),&#xA;        [Total Amount]      VARCHAR(50)&#xA;    );&#xA;END&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
